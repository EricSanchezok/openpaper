# Stable production configuration. Install as /etc/scholens/runtime.env with mode 0600.

SCHOLENS_DOMAIN=scholens.example.com
SCHOLENS_AWS_REGION=us-east-1
SCHOLENS_RELEASE_SHA=
SCHOLENS_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
SCHOLENS_RDS_CA_PATH=/etc/scholens/global-bundle.pem
SANCHEZCLOUD_EDGE_NETWORK=sanchezcloud-edge

# Both URLs point to the shared sanchezcloud database with distinct least-privilege roles.
# Percent-encode passwords. Models and migrations qualify schemas explicitly.
SCHOLENS_APP_DATABASE_URL=postgresql+psycopg2://scholens_app:ENCODED_PASSWORD@RDS_HOST:5432/sanchezcloud?sslmode=verify-full&sslrootcert=/etc/ssl/certs/global-bundle.pem
SCHOLENS_MIGRATION_DATABASE_URL=postgresql+psycopg2://scholens_migrator:ENCODED_PASSWORD@RDS_HOST:5432/sanchezcloud?sslmode=verify-full&sslrootcert=/etc/ssl/certs/global-bundle.pem
SCHOLENS_AUTH_PG_POOL_MIN_SIZE=2
SCHOLENS_AUTH_PG_POOL_MAX_SIZE=10

# Generate independently for Scholens and preserve across releases.
SCHOLENS_AUTH_JWT_SECRET=
SCHOLENS_AUTH_JWT_ACCESS_TOKEN_TTL_MINUTES=15
SCHOLENS_AUTH_JWT_REFRESH_TOKEN_TTL_DAYS=7
SCHOLENS_AUTH_ACCOUNT_LOCKOUT_THRESHOLD=5
SCHOLENS_AUTH_ACCOUNT_LOCKOUT_DURATION_MINUTES=15
SCHOLENS_ADMIN_SESSION_SECRET=
SCHOLENS_PAPER_SEARCH_CURSOR_SECRET=
SCHOLENS_PAPER_SEARCH_BACKEND=postgres_fts
SCHOLENS_RABBITMQ_PASSWORD=
SCHOLENS_REDIS_PASSWORD=

SCHOLENS_ALIYUN_DM_ACCESS_KEY_ID=
SCHOLENS_ALIYUN_DM_ACCESS_KEY_SECRET=
SCHOLENS_ALIYUN_DM_ACCOUNT_NAME=
SCHOLENS_ALIYUN_DM_FROM_ALIAS=Scholens
SCHOLENS_ALIYUN_DM_REPLY_TO_ADDRESS=true

# The EC2 instance role should grant access to this bucket; static AWS keys are not needed.
# Asset hostname excludes https://, for example:
# scholens-prod-ACCOUNT-REGION-an.s3.REGION.amazonaws.com
SCHOLENS_S3_BUCKET_NAME=
SCHOLENS_CLOUDFLARE_BUCKET_NAME=

SCHOLENS_DEEPSEEK_API_KEY=
SCHOLENS_DEEPSEEK_BASE_URL=https://api.deepseek.com
SCHOLENS_DEEPSEEK_STANDARD_MODEL=deepseek-v4-flash
SCHOLENS_DEEPSEEK_DEEP_MODEL=deepseek-v4-pro
SCHOLENS_DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120
SCHOLENS_DEEPSEEK_MAX_OUTPUT_TOKENS=393216
SCHOLENS_DEEPSEEK_MAX_RETRIES=2
SCHOLENS_DEEPSEEK_STRUCTURED_RETRIES=2
SCHOLENS_DEEPSEEK_MAX_INPUT_CHARS=300000
SCHOLENS_MINERU_API_TOKEN=
SCHOLENS_MINERU_API_BASE_URL=https://mineru.net/api/v4
SCHOLENS_MINERU_MODEL_VERSION=vlm
SCHOLENS_MINERU_POLL_INTERVAL_SECONDS=3
SCHOLENS_MINERU_TASK_TIMEOUT_SECONDS=600
SCHOLENS_MINERU_REQUEST_TIMEOUT_SECONDS=60
SCHOLENS_MINERU_MAX_ARCHIVE_BYTES=268435456
SCHOLENS_MOSS_API_KEY=
SCHOLENS_MOSS_API_BASE_URL=https://api.mosi.cn/v1
SCHOLENS_MOSS_TTS_MODEL=moss-tts
SCHOLENS_MOSS_VOICE_ID=
SCHOLENS_MOSS_POLL_INTERVAL_SECONDS=3
SCHOLENS_MOSS_TASK_TIMEOUT_SECONDS=600
SCHOLENS_MOSS_MAX_AUDIO_BYTES=104857600
SCHOLENS_JOB_DISPATCH_INTERVAL_SECONDS=1
SCHOLENS_JOB_DISPATCH_PUBLISH_LEASE_SECONDS=30
SCHOLENS_JOBS_WEBHOOK_SIGNING_SECRET=
SCHOLENS_AI_MAX_INTERACTIVE_PER_USER=8
SCHOLENS_AI_MAX_BACKGROUND_PER_USER=4
SCHOLENS_AI_MAX_AUDIO_PER_USER=2
SCHOLENS_AI_RATE_WINDOW_SECONDS=60
SCHOLENS_AI_RATE_PER_USER=60
SCHOLENS_AI_RATE_PER_IP=120
SCHOLENS_AI_CONCURRENCY_TTL_SECONDS=7200
SCHOLENS_SCHOLIGHT_MCP_URL=https://scholight.sanchezcloud.net/api/mcp
SCHOLENS_SCHOLIGHT_MCP_DELEGATION_JWT_SECRET=
SCHOLENS_CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=

SCHOLENS_STRIPE_API_KEY=
SCHOLENS_STRIPE_WEBHOOK_SECRET=
SCHOLENS_STRIPE_MONTHLY_PRICE_ID=
SCHOLENS_STRIPE_YEARLY_PRICE_ID=

SCHOLENS_ZOTERO_CLIENT_KEY=
SCHOLENS_ZOTERO_CLIENT_SECRET=
SCHOLENS_RESEND_API_KEY=
SCHOLENS_RESEND_FROM_ADDRESS=
SCHOLENS_RESEND_REPLY_TO_ADDRESS=
SCHOLENS_PROFILE_NOTIFICATION_EMAIL=
SCHOLENS_SOURCE_REPOSITORY_URL=https://github.com/EricSanchezok/openpaper
SCHOLENS_POSTHOG_API_KEY=

# Created by deploy/production/observability.yaml. The EC2 role receives write-only access.
SCHOLENS_OTEL_EXPORTER_OTLP_ENDPOINT=host.docker.internal:4317
SCHOLENS_DIAGNOSTIC_SNAPSHOT_BUCKET=
SCHOLENS_DIAGNOSTIC_SNAPSHOT_KMS_KEY_ID=
SCHOLENS_DIAGNOSTIC_SUCCESS_SAMPLE_RATE=0.01

SCHOLENS_WEB_CONCURRENCY=2
SCHOLENS_CELERY_CONCURRENCY=2
