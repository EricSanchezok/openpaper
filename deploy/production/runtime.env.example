# Stable production configuration. Install as /etc/openpaper/runtime.env with mode 0600.

OPENPAPER_DOMAIN=openpaper.example.com
OPENPAPER_AWS_REGION=us-east-1
OPENPAPER_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
OPENPAPER_RDS_CA_PATH=/etc/openpaper/global-bundle.pem
SANCHEZCLOUD_EDGE_NETWORK=sanchezcloud-edge

# Both URLs point to the shared sanchezcloud database with distinct least-privilege roles.
# Percent-encode passwords. Models and migrations qualify schemas explicitly.
OPENPAPER_APP_DATABASE_URL=postgresql+psycopg2://openpaper_app:ENCODED_PASSWORD@RDS_HOST:5432/sanchezcloud?sslmode=verify-full&sslrootcert=/etc/ssl/certs/global-bundle.pem
OPENPAPER_MIGRATION_DATABASE_URL=postgresql+psycopg2://openpaper_migrator:ENCODED_PASSWORD@RDS_HOST:5432/sanchezcloud?sslmode=verify-full&sslrootcert=/etc/ssl/certs/global-bundle.pem
OPENPAPER_AUTH_PG_POOL_MIN_SIZE=2
OPENPAPER_AUTH_PG_POOL_MAX_SIZE=10

# Generate independently for OpenPaper and preserve across releases.
OPENPAPER_AUTH_JWT_SECRET=
OPENPAPER_AUTH_JWT_ACCESS_TOKEN_TTL_MINUTES=15
OPENPAPER_AUTH_JWT_REFRESH_TOKEN_TTL_DAYS=7
OPENPAPER_AUTH_ACCOUNT_LOCKOUT_THRESHOLD=5
OPENPAPER_AUTH_ACCOUNT_LOCKOUT_DURATION_MINUTES=15
OPENPAPER_ADMIN_SESSION_SECRET=
OPENPAPER_RABBITMQ_PASSWORD=
OPENPAPER_REDIS_PASSWORD=

OPENPAPER_ALIYUN_DM_ACCESS_KEY_ID=
OPENPAPER_ALIYUN_DM_ACCESS_KEY_SECRET=
OPENPAPER_ALIYUN_DM_ACCOUNT_NAME=
OPENPAPER_ALIYUN_DM_FROM_ALIAS=OpenPaper
OPENPAPER_ALIYUN_DM_REPLY_TO_ADDRESS=true

# The EC2 instance role should grant access to this bucket; static AWS keys are not needed.
OPENPAPER_S3_BUCKET_NAME=
OPENPAPER_CLOUDFLARE_BUCKET_NAME=

OPENPAPER_DEEPSEEK_API_KEY=
OPENPAPER_DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENPAPER_DEEPSEEK_STANDARD_MODEL=deepseek-v4-flash
OPENPAPER_DEEPSEEK_DEEP_MODEL=deepseek-v4-pro
OPENPAPER_DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120
OPENPAPER_DEEPSEEK_MAX_OUTPUT_TOKENS=8192
OPENPAPER_DEEPSEEK_MAX_RETRIES=2
OPENPAPER_DEEPSEEK_STRUCTURED_RETRIES=2
OPENPAPER_DEEPSEEK_MAX_INPUT_CHARS=300000
OPENPAPER_MINERU_API_TOKEN=
OPENPAPER_MINERU_API_BASE_URL=https://mineru.net/api/v4
OPENPAPER_MINERU_MODEL_VERSION=vlm
OPENPAPER_MINERU_POLL_INTERVAL_SECONDS=3
OPENPAPER_MINERU_TASK_TIMEOUT_SECONDS=600
OPENPAPER_MINERU_SOURCE_URL_TTL_SECONDS=900
OPENPAPER_MINERU_MAX_ARCHIVE_BYTES=268435456
OPENPAPER_MOSS_API_KEY=
OPENPAPER_MOSS_API_BASE_URL=https://api.mosi.cn/v1
OPENPAPER_MOSS_TTS_MODEL=moss-tts
OPENPAPER_MOSS_VOICE_ID=
OPENPAPER_MOSS_POLL_INTERVAL_SECONDS=3
OPENPAPER_MOSS_TASK_TIMEOUT_SECONDS=600
OPENPAPER_MOSS_MAX_AUDIO_BYTES=104857600
OPENPAPER_JOBS_WEBHOOK_SIGNING_SECRET=
OPENPAPER_AI_MAX_INTERACTIVE_PER_USER=8
OPENPAPER_AI_MAX_BACKGROUND_PER_USER=4
OPENPAPER_AI_MAX_AUDIO_PER_USER=2
OPENPAPER_AI_RATE_WINDOW_SECONDS=60
OPENPAPER_AI_RATE_PER_USER=60
OPENPAPER_AI_RATE_PER_IP=120
OPENPAPER_AI_CONCURRENCY_TTL_SECONDS=7200
OPENPAPER_ANYSEARCH_MCP_URL=https://api.anysearch.com/mcp
OPENPAPER_ANYSEARCH_API_KEY=
OPENPAPER_SCHOLIGHT_MCP_URL=https://scholight.sanchezcloud.net/api/mcp
OPENPAPER_SCHOLIGHT_MCP_DELEGATION_JWT_SECRET=

OPENPAPER_STRIPE_API_KEY=
OPENPAPER_STRIPE_WEBHOOK_SECRET=
OPENPAPER_STRIPE_MONTHLY_PRICE_ID=
OPENPAPER_STRIPE_YEARLY_PRICE_ID=

OPENPAPER_ZOTERO_CLIENT_KEY=
OPENPAPER_ZOTERO_CLIENT_SECRET=
OPENPAPER_RESEND_API_KEY=
OPENPAPER_RESEND_MAIN_AUDIENCE_ID=
OPENPAPER_POSTHOG_API_KEY=

OPENPAPER_WEB_CONCURRENCY=2
OPENPAPER_CELERY_CONCURRENCY=2
