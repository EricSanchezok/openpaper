# Scholens Environment Variables
# This is the single committed configuration catalog. Copy only the variables
# owned by each runtime into server/.env, jobs/.env, or client/.env.local.
# Never copy server or jobs secrets into the client directory. Runtime files
# are git-ignored and must never be committed with real credentials.

# ═══════════════════════════════════════════════════════════════════
# PostgreSQL (shared SanchezCloud database)
# ═══════════════════════════════════════════════════════════════════
# Local example. To share local users with Scholight, point this at the same
# sanchezcloud database that contains auth.users.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sanchezcloud
# cloud-auth's independent migration CLI reads AUTH_DATABASE_URL explicitly.
AUTH_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sanchezcloud

# Production uses separate least-privilege scholens_app/scholens_migrator
# roles and RDS TLS. See deploy/production/runtime.env.example.
AUTH_PG_SSL_ROOT_CERT=
AUTH_PG_POOL_MIN_SIZE=2
AUTH_PG_POOL_MAX_SIZE=10

# ═══════════════════════════════════════════════════════════════════
# JWT & cloud-auth
# ═══════════════════════════════════════════════════════════════════
# The client_id is fixed to "scholens" in code. Use a product-specific secret;
# do not reuse Scholight's JWT secret. Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_JWT_REFRESH_TOKEN_TTL_DAYS=7
AUTH_ACCOUNT_LOCKOUT_THRESHOLD=5
AUTH_ACCOUNT_LOCKOUT_DURATION_MINUTES=15
AUTH_PUBLIC_WEB_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════
# Email (Aliyun DirectMail — password reset, email verification)
# ═══════════════════════════════════════════════════════════════════
# These may use the same Aliyun account as Scholight; sender alias and action
# URLs remain product-specific.
AUTH_ALIYUN_DM_ACCESS_KEY_ID=
AUTH_ALIYUN_DM_ACCESS_KEY_SECRET=
AUTH_ALIYUN_DM_ACCOUNT_NAME=
AUTH_ALIYUN_DM_FROM_ALIAS=Scholens
AUTH_ALIYUN_DM_REPLY_TO_ADDRESS=true

# ═══════════════════════════════════════════════════════════════════
# Public URLs / server
# ═══════════════════════════════════════════════════════════════════
CLIENT_DOMAIN=http://localhost:3000
HOST=0.0.0.0
PORT=8000
RELOAD=false
ENVIRONMENT=development

# ═══════════════════════════════════════════════════════════════════
# Object storage (S3-compatible) [server + jobs]
# ═══════════════════════════════════════════════════════════════════
# Production should use the EC2 instance role instead of static AWS keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# Canonical asset hostname without https://. For AWS use:
# <bucket>.s3.<region>.amazonaws.com. Presigned URLs retain the provider host.
CLOUDFLARE_BUCKET_NAME=
UPLOAD_DIR=uploads

# ═══════════════════════════════════════════════════════════════════
# AI model (internal only) [server + jobs]
# ═══════════════════════════════════════════════════════════════════
# The browser never receives these values or model names.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_STANDARD_MODEL=deepseek-v4-flash
DEEPSEEK_DEEP_MODEL=deepseek-v4-pro
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_STRUCTURED_RETRIES=2
DEEPSEEK_MAX_INPUT_CHARS=300000

# MinerU is the high-fidelity Jobs parser. PyMuPDF provides text-only fallback.
MINERU_API_TOKEN=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_SECONDS=3
# Shared deadline for submit, upload, poll, and archive download before fallback.
MINERU_TASK_TIMEOUT_SECONDS=600
MINERU_REQUEST_TIMEOUT_SECONDS=60
MINERU_MAX_ARCHIVE_BYTES=268435456

# MOSS Voice runs in Jobs; the script itself is generated there by DeepSeek.
MOSS_API_KEY=
MOSS_API_BASE_URL=https://api.mosi.cn/v1
MOSS_TTS_MODEL=moss-tts
MOSS_VOICE_ID=
MOSS_POLL_INTERVAL_SECONDS=3
MOSS_TASK_TIMEOUT_SECONDS=600
MOSS_MAX_AUDIO_BYTES=104857600

# ═══════════════════════════════════════════════════════════════════
# Background jobs (RabbitMQ + Redis)
# ═══════════════════════════════════════════════════════════════════
CELERY_BROKER_URL=pyamqp://guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Jobs only; defaults to CELERY_RESULT_BACKEND when omitted.
PDF_PARSE_REDIS_URL=redis://localhost:6379/0
CELERY_API_URL=http://localhost:8001
WEBHOOK_BASE_URL=http://localhost:8000
JOBS_WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-bytes
# Server outbox polling interval; durable jobs remain in PostgreSQL until published.
JOB_DISPATCH_INTERVAL_SECONDS=1
ZOTERO_SYNC_INTERVAL_SECONDS=60

# ═══════════════════════════════════════════════════════════════════
# Remote MCP search tools and integrations
# ═══════════════════════════════════════════════════════════════════
ANYSEARCH_MCP_URL=https://api.anysearch.com/mcp
ANYSEARCH_API_KEY=
SCHOLIGHT_MCP_URL=https://scholight.sanchezcloud.net/api/mcp
# Must match Scholight's SCHOLIGHT_MCP_DELEGATION_JWT_SECRET. Scholens creates a
# 60-second user delegation for each call; no platform access key is used.
SCHOLIGHT_MCP_DELEGATION_JWT_SECRET=replace-with-at-least-32-random-bytes
OPENALEX_API_KEY=
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=
ZOTERO_REDIRECT_URI=http://localhost:8000/api/auth/zotero/callback

# ═══════════════════════════════════════════════════════════════════
# Billing
# ═══════════════════════════════════════════════════════════════════
STRIPE_API_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ═══════════════════════════════════════════════════════════════════
# Product email, telemetry, and admin
# ═══════════════════════════════════════════════════════════════════
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO_ADDRESS=
PROFILE_NOTIFICATION_EMAIL=
SOURCE_REPOSITORY_URL=https://github.com/EricSanchezok/openpaper
POSTHOG_API_KEY=
DEBUG=false
ADMIN_SESSION_SECRET=replace-with-an-independent-32-byte-secret

# Cross-instance abuse controls (Redis-backed)
AI_LIMIT_REDIS_URL=redis://localhost:6379/1
AI_MAX_INTERACTIVE_PER_USER=8
AI_MAX_BACKGROUND_PER_USER=4
AI_MAX_AUDIO_PER_USER=2
AI_RATE_WINDOW_SECONDS=60
AI_RATE_PER_USER=60
AI_RATE_PER_IP=120
AI_CONCURRENCY_TTL_SECONDS=7200

# ═══════════════════════════════════════════════════════════════════
# Client (Next.js)
# ═══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
